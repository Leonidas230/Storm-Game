{
  "name": "Storm-Game",
  "servePort": 34872,
  "globIgnorePaths": [
    "**/package.json",
    "**/tsconfig.json"
  ],
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "ReplicatedStorage": {
      "Assets": {
        "$path": "assets"
      },
      "Config": {
        "$path": "config"
      },
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      },
      "Shared": {
        "$path": "out/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "out/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$className": "Folder",
            "$path": "out/client"
        }
      }
    }
  }
}
